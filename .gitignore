# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets — never commit real credentials
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Uploaded attachments
server/upload

# Control-script runtime state (pid, logs)
.run

# Finder-style copy duplicates ("README 2.md", "server/index 3.js").
# Forty-two of these had been committed to the production repository by
# repeated copying, shipping stale modules alongside the real ones. Ignoring
# them means a stray copy can never be committed again by accident.
* [0-9].*
* [0-9]
~$*.xlsx
