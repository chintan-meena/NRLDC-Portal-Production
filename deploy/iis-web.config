<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config for the NRLDC Schedule Discrepancy Portal (Windows).

  Drop this into the IIS site's physical root as `web.config`. See
  DEPLOYMENT-WINDOWS.md §6. Prerequisites, installed once at the server level:
    • URL Rewrite module
    • Application Request Routing (ARR), with "Enable proxy" ticked
      (IIS Manager → server → Application Request Routing Cache →
       Server Proxy Settings → Enable proxy)

  What it does:
    1. Redirects all plain-HTTP (port 80) requests to HTTPS.
    2. Reverse-proxies everything else to the Node server on 127.0.0.1:8102.

  ARR adds the X-Forwarded-For header the app's rate limiter reads; keep
  TRUST_PROXY_HOPS in server/.env equal to the number of proxies in front of
  Node (one IIS/ARR hop = 1). Verify via https://<host>/api/health.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <!-- X-Forwarded-Proto is optional (the app decides HSTS from BEHIND_TLS,
           not this header) but correct to pass through. It must be declared
           here before a rule may set it. -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>

      <rules>
        <!-- 1. Force HTTPS. Runs first; stops processing on a plain-HTTP hit. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- 2. Reverse proxy to the Node backend. -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8102/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Raise if large WBES uploads return HTTP 413. Match the app's own limit
         in server/config/uploads.js. Example: 50 MB. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Don't advertise the server software. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
